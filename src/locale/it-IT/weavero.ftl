weavero-sf-delete-folder =
    .label = Elimina cartella
weavero-sf-folder-name-title = Cartella di ricerche salvate
weavero-sf-folder-name-prompt = Nome della cartella:
weavero-sf-delete-confirm = Eliminare la cartella «{ $name }» e { $count ->
        [one] la sua sottocartella
       *[other] le sue { $count } sottocartelle
    }? Le ricerche salvate al loro interno restano nella tua biblioteca, fuori da qualsiasi cartella.
weavero-sf-name-folder = Dai nomi delle ricerche: { $path }
weavero-pref-collections-bookmarks-pane =
    .label = Riquadro dei segnalibri sopra le collezioni
weavero-pref-collections-bookmarks-pane-desc = I segnalibri della tua libreria in un riquadro sopra l’albero delle collezioni, con un divisore tra i due. Fai clic sulla sua intestazione per comprimerlo; il suo pulsante ⇕ mostra solo i segnalibri, al posto dell’albero delle collezioni. Le cartelle si aprono sul posto, e gli elementi rilasciati sul segnalibro di una collezione vanno in quella collezione. Ogni finestra conserva la propria disposizione, salvata con la sua sessione. Il pulsante Segnalibri sopra le collezioni resta.
weavero-bmpane-fold-tip = { $folded ->
        [yes] Espandi i segnalibri
       *[other] Comprimi i segnalibri
    }
weavero-bmpane-only-tip = { $on ->
        [yes] Mostra di nuovo l’albero delle collezioni
       *[other] Solo segnalibri: nascondi l’albero delle collezioni
    }
weavero-bmpane-now-tip = Visualizzato: { $name }. Fai clic per mostrare l’albero delle collezioni con questo elemento.
weavero-bmpane-now-add = Aggiungi ai segnalibri
weavero-bmpane-folder-current = Questa cartella contiene ciò che è visualizzato
# The funnel above the collections pane (coll-funnel.ts): Settings.
weavero-pref-collections-funnel =
    .label = Imbuto sopra il riquadro delle collezioni
weavero-pref-collections-funnel-desc = Un pulsante a imbuto nella barra degli strumenti del riquadro delle collezioni filtra ciò che il riquadro mostra: collezioni, ricerche salvate, feed, le righe speciali (Elementi duplicati, Elementi non collocati, Cestino…), ogni biblioteca e le sezioni proprie di Weavero. Fai clic su un chip per mostrare solo quello, Alt+clic per nasconderlo. Ogni finestra mantiene il proprio filtro, salvato con la sua sessione; «Usa come predefinito» nell’imbuto lo rende il filtro da cui parte ogni finestra.
weavero-pref-collfunnel-defaults-title = Mostrato per impostazione predefinita
weavero-pref-collfunnel-show-collections =
    .label = Collezioni
weavero-pref-collfunnel-show-searches =
    .label = Ricerche salvate
weavero-pref-collfunnel-show-feeds =
    .label = Feed
weavero-pref-collfunnel-show-special =
    .label = Righe speciali
weavero-pref-collfunnel-show-bookmarks =
    .label = Riquadro dei segnalibri
weavero-pref-collfunnel-show-folders =
    .label = Cartelle delle ricerche salvate
# The libraries the default leaves out. $mode: hidden, only or none; $names: the libraries.
weavero-pref-collfunnel-libs = { $mode ->
        [hidden] Biblioteche nascoste per impostazione predefinita: { $names }
        [only] Biblioteche mostrate per impostazione predefinita: solo { $names }
       *[none] Tutte le biblioteche sono mostrate per impostazione predefinita.
    }
weavero-pref-collfunnel-libs-reset = Reimposta
# The funnel's button. $active: yes when it filters; $parts: what it filters.
weavero-cf-tb-tip = { $active ->
        [yes] Filtro del riquadro delle collezioni: { $parts }
       *[no] Filtra il riquadro delle collezioni
    }
# The funnel's rows of chips.
weavero-cf-row-kinds = Tipi
weavero-cf-row-libs = Biblioteche
weavero-cf-row-secs = Sezioni di Weavero
weavero-cf-kind-collections = Collezioni
weavero-cf-kind-searches = Ricerche salvate
weavero-cf-kind-feeds = Feed
weavero-cf-kind-special = Righe speciali
weavero-cf-kind-special-tip = Elementi duplicati, Elementi non collocati, Letti di recente, Elementi ritirati dalla pubblicazione, Le mie pubblicazioni e Cestino
weavero-cf-sec-bookmarks = Riquadro dei segnalibri
weavero-cf-sec-folders = Cartelle delle ricerche salvate
weavero-cf-hint = Clic: mostra solo questo. Alt+clic: nascondi.
# What a row filters, in the button's tooltip. $mode: only or hide; $names: the chips.
weavero-cf-part = { $mode ->
        [only] solo { $names }
       *[hide] senza { $names }
    }
# The footer's line. $scope: window (this window's own filter) or default.
weavero-cf-scope = { $scope ->
        [window] Filtro proprio di questa finestra
       *[default] Segue il predefinito
    }
    .title = { $scope ->
        [window] Questa finestra si discosta dal filtro predefinito; «Torna al predefinito» lo segue di nuovo.
       *[default] Questa finestra mostra il filtro predefinito, che «Usa come predefinito» modifica.
    }
weavero-cf-use-default = Usa come predefinito
    .title = Rendi questo filtro, così com’è, quello da cui parte ogni finestra
weavero-cf-reset-default = Torna al predefinito
    .title = Torna al filtro predefinito in questa finestra
# Where the funnel leaves nothing in the tree.
weavero-cf-empty = Niente corrisponde all’imbuto.
weavero-cf-empty-clear = Cancella
weavero-pref-collections-sticky-headers =
    .label = Tieni le intestazioni delle sezioni fissate in cima al riquadro degli elementi durante lo scorrimento
weavero-pref-collections-sticky-headers-desc = L’intestazione di ogni sezione resta fissata in cima al riquadro degli elementi mentre la sua sezione scorre, finché l’intestazione successiva non la spinge fuori; dentro Link a elementi, Link in entrata e le sezioni Tag e Correlazioni ampliate, il titolo della parte le cui righe stanno passando resta sotto di essa. Un clic su un’intestazione fissata comprime comunque la sua sezione. Nel riquadro degli elementi della biblioteca e nei riquadri contestuali delle schede del lettore e delle note.
weavero-pref-collections-path-tooltip =
    .label = Mostra il percorso completo di una collezione al passaggio del puntatore
weavero-pref-collections-indent-guides =
    .label = Guide di rientro nel riquadro delle collezioni
weavero-pref-collections-indent-guides-desc = Una sottile linea verticale per ogni livello, così le collezioni sorelle si allineano visivamente.
weavero-pref-plugins-title = Gestione dei plugin
weavero-pref-plugins-extras =
    .label = Aggiunte alla Gestione dei plugin (casella di ricerca, dettagli dei riquadri, finestra normale)
weavero-pref-plugins-extras-desc = Strumenti → Plugin riceve una casella di ricerca (Ctrl+F la attiva, × la svuota), riquadri che mostrano autore [proprietario GitHub] · versione · ultimo aggiornamento, una finestra normale con riduci a icona/ingrandisci (con <em>Nascondi la barra del titolo → Gestione dei plugin</em> attivo, il layout della barra del titolo della finestra principale; disattivato, la barra del titolo e la barra dei menu del sistema), e Aggiornamenti recenti sempre visibile, con un menu sulla sua intestazione per scegliere quanto indietro risale (dall’ultimo giorno a tutti; quello di Zotero si ferma a 2 giorni), scelta che viene ricordata. La gestione si riapre sulla lista dei plugin. Su Zotero 11, la cui gestione nasconde la barra laterale, la barra laterale ritorna con Plugin e Aggiornamenti recenti (e Aggiornamenti disponibili mentre ci sono aggiornamenti in sospeso).
weavero-pref-defatt-title = Allegato predefinito
weavero-pref-defatt-enable =
    .label = Apri un allegato o una nota scelti invece della scelta automatica di Zotero
weavero-pref-defatt-desc = Clic destro su qualsiasi figlio di un elemento — allegato (PDF o no), URL collegato o nota — e scegli <b>▶️ Imposta come allegato predefinito</b> per aprire quello invece della scelta abituale di Zotero. La scelta è salvata come il tag <b>▶️ wv-defatt</b> su quel figlio, quindi si sincronizza sugli altri dispositivi e sopravvive senza Weavero. Cerca <b>wv-defatt</b> (o il simbolo ▶️) per elencare ogni elemento contrassegnato; il tag non contiene di proposito parole comuni, così non compare mai in ricerche estranee. Disattivare questa opzione ferma la sostituzione ma conserva le tue scelte.
weavero-pref-defatt-sort-default =
    .label = Mostra per primo l’allegato predefinito nella lista degli allegati
weavero-pref-defatt-sort-auto =
    .label = Mostra per prima la scelta automatica di Zotero quando non è impostato un predefinito
weavero-pref-defatt-mark-auto =
    .label = Segna la scelta automatica con un ▷ attenuato nella lista degli elementi e nel riquadro degli elementi
weavero-pref-defatt-sort-desc = Con le due opzioni qui sopra, ciò che si apre con il doppio clic sta nella prima riga degli allegati di un elemento. Il <b>▷</b> attenuato mostra sempre la scelta automatica di Zotero — così vedi cosa si aprirebbe se il predefinito scelto venisse rimosso — mentre un predefinito scelto mantiene il suo segno pieno <b>▶️</b>.
weavero-pref-defatt-import = Vieni da <b>Default Attachment</b> di <b>PikaPei</b>? Le tue scelte vengono importate automaticamente al primo avvio di Weavero, e i dati di quel plugin restano intatti — vedi il README per rimuoverli a mano quando non ti servono più.
weavero-pref-ext-viewer-title = Visualizzatore esterno
weavero-pref-ext-viewer-enable =
    .label = “Apri nel visualizzatore esterno” nei menu degli elementi / delle schede
weavero-pref-ext-viewer-desc = Apre il miglior allegato di un elemento con l’app predefinita del sistema (PDF, EPUB, pagina web salvata, immagine, …). Attivo per impostazione predefinita.
weavero-pref-undo-title = Annulla
weavero-pref-undo-buttons =
    .label = Frecce Annulla / Ripeti nella barra degli strumenti del lettore
weavero-pref-undo-buttons-desc = Due frecce dopo gli strumenti di annotazione: clicca per annullare o ripetere l’ultimo passaggio della scheda del lettore (indice, segnalibri, annotazioni), clic destro per la cronologia. Ctrl+Z, Ctrl+Y e Modifica → Annulla funzionano in ogni caso. Attivo per impostazione predefinita.
weavero-pref-link-preview-title = Anteprime dei link
weavero-pref-link-preview-entry =
    .label = Evidenzia l’intero riferimento nelle anteprime dei link
weavero-pref-link-preview-entry-desc = Quando il puntatore si ferma su una citazione, l’anteprima della lista dei riferimenti evidenzia ogni riga della voce citata con una leggera tinta rossa, al posto del riquadro scuro di Zotero sulla sua prima riga. Se disattivato: l’anteprima di Zotero così com’è. Attivo per impostazione predefinita.
weavero-pref-outline-title = Indice del lettore
weavero-pref-outline-highlight =
    .label = Evidenzia il testo del titolo quando clicchi una voce dell’indice
weavero-pref-outline-highlight-desc = Fa lampeggiare il testo reale del titolo al clic, nei PDF, negli EPUB e nelle pagine web salvate, e in una nota dal suo indice; per gli indici incorporati nei PDF Weavero trova il titolo sulla pagina. Corrispondenza approssimativa — con pagine scansionate o font insoliti può limitarsi al salto senza evidenziazione.
weavero-pref-outline-page-numbers =
    .label = Mostra i numeri di pagina accanto alle voci dell’indice
weavero-pref-outline-page-numbers-desc = L’etichetta “p. N” a destra di ogni voce. Clic destro sulla scheda Indice in un lettore per mostrarle o nasconderle solo per quel documento.
weavero-pref-outline-size-title = Dimensione del testo dell’indice
weavero-pref-outline-size-desc = <strong>Indice di Zotero</strong> e <strong>Riquadro degli elementi di Zotero</strong> seguono <em>Aspetto → Dimensione del font</em> (le dimensioni mostrate sono quelle attuali); <strong>Fissa</strong> resta alla dimensione scelta qualunque sia la Dimensione del font. Clic destro sulla scheda Indice in un lettore per scegliere una dimensione solo per quel documento.
weavero-pref-outline-size-zotero =
    .label = Indice di Zotero (predefinito)
weavero-pref-outline-size-item-pane =
    .label = Riquadro degli elementi di Zotero
weavero-pref-outline-size-zotero-px =
    .label = Indice di Zotero, { $px } px (predefinito)
weavero-pref-outline-size-item-pane-px =
    .label = Riquadro degli elementi di Zotero, { $px } px
weavero-pref-outline-size-fixed =
    .label = Fissa:
weavero-pref-outline-size-px =
    .label = { $px } px
weavero-pref-outline-keys-title = Scorciatoie da tastiera per aggiungere voci
weavero-pref-outline-keys-desc = Nessuna è impostata di serie. Clicca una casella e premi i tasti che vuoi — va bene anche una sola lettera; le combinazioni già usate da Zotero o dal lettore vengono rifiutate. Funzionano nelle schede del lettore, mai mentre scrivi in un campo di testo, e appaiono accanto alle voci di menu corrispondenti.
weavero-pref-outline-key-selection = Aggiungi il testo selezionato
weavero-pref-outline-key-remove = Rimuovi
weavero-pref-outline-key-pin = Fissa un punto
weavero-pref-outline-key-page-top = Inizio pagina (PDF)
weavero-pref-outline-key-page-bottom = Fine pagina (PDF)
weavero-pref-notes-title = Note
weavero-pref-notes-outline =
    .label = Indice accanto alle note
weavero-pref-notes-outline-desc = Un pannello che elenca i titoli della nota a sinistra della nota, con la sezione che stai leggendo evidenziata. Clicca un titolo per andarci; clic destro per copiarne un link. Aperto per impostazione predefinita nelle schede e nelle finestre delle note, ripiegato nel riquadro degli elementi e accanto a un lettore — il pulsante della barra laterale all’estremità sinistra della barra degli strumenti della nota lo mostra o lo nasconde. Con Better Notes installato, questo indice sostituisce il suo riquadro sinistro nelle schede delle note; deseleziona questa opzione per riavere quel riquadro, con le sue mappe mentali e a bolle.
weavero-pref-notes-folding =
    .label = Frecce di ripiegamento su titoli ed elenchi delle note
weavero-pref-notes-folding-desc = Una freccia nel margine prima di ogni titolo nasconde tutto ciò che sta sotto, fino al titolo successivo dello stesso livello o di un livello superiore. Una freccia prima di una voce di elenco, puntato o numerato, nasconde tutto ciò che sta sotto la sua prima riga: le sue sottovoci e gli altri paragrafi. <em>Ripiega tutto</em> e <em>Espandi tutto</em> in fondo al menu del clic destro della nota agiscono su tutta la nota insieme. Cambia solo la vista — la nota stessa resta intatta, e chi non ha Weavero vede la nota intera. I ripiegamenti sono ricordati per ogni nota su questo computer. Entrambe le opzioni richiedono <em>Link e correlazioni → Note: Editor delle note</em>.
weavero-pref-notes-citations =
    .label = Citazioni dopo i link di Zotero nelle note
weavero-pref-notes-citations-desc = Clic destro su un link <code data-l10n-name="scheme">zotero://</code> in una nota per <em>Aggiungi citazione dopo il link</em>: il link resta, e la citazione dell’elemento creata da Zotero lo segue. Un link a una pagina di un PDF cita l’elemento genitore del PDF a quella pagina (la pagina stampata di un’annotazione che vi si trova, se c’è); un link a un’evidenziatura o a una sottolineatura aggiunge il suo testo citato e la citazione, come quando trascini l’annotazione nella nota. <em>Aggiungi citazioni dopo i link nella selezione</em> e <em>Aggiungi citazioni dopo tutti i link</em> ne aggiungono diverse insieme; un solo Annulla le ritira tutte. Le citazioni sono quelle di Zotero: si sincronizzano e si leggono allo stesso modo senza Weavero. I link alle note, ai file senza elemento genitore e a un’altra biblioteca restano come sono. Richiede <em>Link e correlazioni → Note: Editor delle note</em>.
weavero-pref-annpane-title = Riquadro delle annotazioni del lettore
weavero-pref-annpane-reader-funnel =
    .label = Imbuto sopra il lettore
weavero-pref-annpane-reader-funnel-desc = Filtra le annotazioni del documento sulla pagina e nel riquadro delle annotazioni insieme — per colore, tipo, tag, commento, persona o data. Se disattivato, il pulsante scompare e il suo filtro viene messo da parte: tutte le annotazioni tornano visibili, tranne quelle filtrate dal selettore di colori e tag di Zotero. Riattivato, un documento aperto ritrova il proprio filtro.
weavero-pref-annpane-funnel =
    .label = Imbuto accanto alla casella di ricerca del riquadro
weavero-pref-annpane-funnel-desc = A differenza dell’imbuto sopra il lettore, che nasconde le annotazioni anche dalla pagina, questo restringe solo il riquadro delle annotazioni — per colore, tipo, tag, commento, persona o data — e la pagina mantiene ogni annotazione. Stessi chip e stessi gesti. Ogni documento mantiene il proprio filtro; i tipi qui sotto sono il punto di partenza per tutti. Con l’imbuto disattivato, il riquadro segue semplicemente i tipi qui sotto.
weavero-pref-annpane-selector-handle =
    .label = Maniglia sul selettore di colori e tag di Zotero in fondo al riquadro
weavero-pref-annpane-selector-handle-desc = Una piccola pillola sul bordo superiore del selettore: un clic ripiega il selettore su quel bordo, il successivo lo riporta — un solo stato per tutti i documenti, mantenuto dopo i riavvii (mostrato all’inizio). <em>Aspetto → Layout → Selettore di colori e tag</em> nasconde del tutto il selettore, pillola compresa, come fa la voce Riquadro dei tag della biblioteca. Quando è aperto, il selettore filtra insieme il riquadro e il documento, e un’annotazione trascinata su un colore o un tag lo assume (Maiusc per rimuoverlo). Una selezione resta in vigore mentre è ripiegato; la pillola diventa blu per segnalarlo. Se disattivato, il selettore è sempre mostrato, come in Zotero.
weavero-pref-annpane-types-title = Tipi di annotazione mostrati nel riquadro
weavero-pref-annpane-types-desc = Deseleziona un tipo per escluderlo dal riquadro in ogni documento; resta visibile sulla pagina. L’imbuto può ignorare questa scelta per un documento, e il suo “Usa come predefinito” la riscrive qui.
weavero-pref-annpane-type-highlight =
    .label = Evidenziature
weavero-pref-annpane-type-underline =
    .label = Sottolineature
weavero-pref-annpane-type-note =
    .label = Note
weavero-pref-annpane-type-image =
    .label = Immagini
weavero-pref-annpane-type-ink =
    .label = A mano libera
weavero-pref-annpane-type-text =
    .label = Testo
weavero-pref-debug-title = Debug
weavero-pref-debug-enable =
    .label = Attiva il registro di debug
weavero-pref-debug-desc = Registra un’attività dettagliata tramite Zotero.debug (Aiuto → Registro dei messaggi di debug → Vedi il registro di debug). Lascia disattivato per l’uso normale.
weavero-pref-about-title = Informazioni
weavero-pref-about-homepage = Pagina principale — GitHub
weavero-pref-about-bug-report = Segnalazione di bug / richiesta di funzionalità

