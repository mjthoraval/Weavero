# ---- Backlinks and Item Links (backlinks.ts, links.ts) ----
weavero-bl-ref-title = { $kind ->
        [links] { $count } 个条目链接
       *[backlinks] { $count } 个反向链接
    }
weavero-bl-internal-tip = 内部链接：两端都在“{ $title }”中
weavero-bl-page = 第 { $page } 页
weavero-bl-note-pos = { $at ->
        [line] 第 { $value } 行
        [section] #{ $value }
       *[heading] 标题
    }
weavero-bl-att-kind = { $kind ->
        [pdf] PDF
        [epub] EPUB
        [snapshot] 网页快照
        [file] 文件
       *[attachment] 附件
    }
weavero-bl-row-label = { $ref ->
        [citation] { $paged ->
            [yes] 笔记引注，第 { $page } 页
           *[no] 笔记引注
        }
        [quote] { $paged ->
            [yes] 笔记引注，注释第 { $page } 页{ $file }
           *[no] 笔记引注，注释{ $file }
        }
       *[link] Zotero 链接
    }
weavero-bl-kind = { $kind ->
        [cite] 笔记引注
       *[zotero] Zotero 链接
    }
weavero-bl-action = { $action ->
        [select] 在文库中显示
        [annotation] 在注释处打开
        [page] 在第 { $page } 页打开
       *[open] 打开
    }
weavero-bl-action-open-note = { $at ->
        [line] 在第 { $value } 行打开笔记（Better Notes）
        [section] 在“{ $value }”节打开笔记（Better Notes）
        [heading] 在标题处打开笔记
       *[none] 打开笔记（Better Notes）
    }
weavero-bl-action-quote = { $form ->
        [page-cited] 注释第 { $page } 页，引用第 { $cited } 页
        [page] 注释第 { $page } 页
        [cited] 注释，引用第 { $cited } 页
        [gone] 注释，第 { $page } 页
       *[plain] 注释
    }
weavero-bl-chip = { $to ->
        [here] → { weavero-bl-note-pos }
        [annotation] → 注释{ $file }
        [annotation-page] → 注释第 { $page } 页{ $file }
        [note] → 笔记
        [note-pos] → 笔记 { weavero-bl-note-pos }
        [attachment-page] → { weavero-bl-att-kind } 第 { $page } 页
       *[attachment] → { weavero-bl-att-kind }
    }
weavero-bl-broken = { $why ->
        [library] 此配置文件中没有该文库
       *[item] 未找到条目
    }
weavero-bl-broken-why = { $why ->
        [library] 该链接指向一个不在此配置文件中的群组文库。
       *[item] 文库中没有条目使用此键：该条目已被删除，或链接有误。
    }
weavero-bl-card-page = 页
weavero-bl-card-comment = 评论：{ $text }
weavero-bl-card-note = 笔记

