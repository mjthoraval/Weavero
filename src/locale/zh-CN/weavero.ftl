# Weavero -- Simplified Chinese (zh-CN).
# Machine-assisted translation (Claude), to be reviewed by a native speaker.
# Source: locale/en-US/weavero.ftl. Terms Weavero shares with Zotero follow
# Zotero's own zh-CN translation.

weavero-backlinks-header =
    .label = { $count } 个反向链接
weavero-backlinks-sidenav =
    .tooltiptext = 反向链接
weavero-links-header =
    .label = { $count } 个条目链接
weavero-links-sidenav =
    .tooltiptext = 条目链接

weavero-pref-nav-links = 链接与关联
weavero-pref-nav-filters = 排序与筛选
weavero-pref-nav-bookmarks = 书签
weavero-pref-nav-tabs = 标签页与窗口
weavero-pref-nav-extras = 附加功能
weavero-pref-intro = 评论和笔记中的可点击链接、条目列表和标签页中的筛选、书签，以及条目列表的额外列。大多数功能默认开启；用不到的可以关闭。

weavero-pref-links-title = 链接与关联
weavero-pref-links-enable =
    .aria-label = 启用链接与关联
weavero-pref-links-desc = 在文本中支持可点击的 URI 和 Markdown，用图标标识并前往相关条目，并提供右键工具来复制 Zotero 链接和添加相关条目。

weavero-pref-links-mode-title = 显示模式
weavero-pref-links-mode-desc = 链接和 Markdown 在评论和笔记中的呈现方式：<strong>内联</strong>完整渲染；<strong>图标与弹窗</strong>保持纯文本，通过弹窗打开（更轻量）。
weavero-pref-links-mode-inline =
    .label = 内联
weavero-pref-links-mode-icon =
    .label = 图标与弹窗
weavero-pref-links-show = 显示：
weavero-pref-links-show-urls =
    .label = 网址
weavero-pref-links-show-zotero =
    .label = Zotero 链接
weavero-pref-links-show-app =
    .label = 应用链接
weavero-pref-links-show-markdown =
    .label = Markdown
weavero-pref-links-markdown-desc = Markdown：<strong>**粗体**</strong>、<em>*斜体*</em>、~~删除线~~、<span data-l10n-name="mono">`code`</span>、<span data-l10n-name="mono2">[label](url)</span>。应用链接协议在下方选择。

weavero-pref-links-schemes-title = 应用链接协议
weavero-pref-links-schemes-desc = Weavero 在评论中识别为应用链接的协议。仅在上方的<strong>应用链接</strong>开启时生效。
weavero-pref-links-schemes-no-confirm =
    .label = 打开时不显示确认对话框
weavero-pref-links-schemes-no-confirm-desc = 对已启用的协议，跳过 Firefox 的“允许此网站打开 … 链接吗？”提示。
weavero-pref-links-scheme-magnet =
    .label = magnet:
    .tooltiptext = 种子磁力链接
weavero-pref-links-scheme-mailto =
    .label = mailto:
    .tooltiptext = 电子邮件地址
weavero-pref-links-scheme-skype =
    .label = skype:
    .tooltiptext = Skype 通话 / 聊天
weavero-pref-links-scheme-sms =
    .label = sms:
    .tooltiptext = 短信
weavero-pref-links-scheme-spotify =
    .label = spotify:
    .tooltiptext = Spotify 曲目 / 播放列表
weavero-pref-links-scheme-tel =
    .label = tel:
    .tooltiptext = 电话号码
weavero-pref-links-scheme-discord =
    .label = discord://
    .tooltiptext = Discord 服务器
weavero-pref-links-scheme-evernote =
    .label = evernote://
    .tooltiptext = Evernote 笔记
weavero-pref-links-scheme-figma =
    .label = figma://
    .tooltiptext = Figma 文件
weavero-pref-links-scheme-file =
    .label = file://
    .tooltiptext = 本地文件（打开前询问）
weavero-pref-links-remote-file =
    .label = 允许指向其他计算机上文件的链接（网络共享）
weavero-pref-links-remote-file-desc = 每个链接在首次打开前询问一次；Weavero 会记住您打开过的链接。关闭此选项会清除这些记录。
weavero-pref-links-scheme-ftp =
    .label = ftp://
    .tooltiptext = FTP 服务器
weavero-pref-links-scheme-msteams =
    .label = msteams://
    .tooltiptext = Microsoft Teams
weavero-pref-links-scheme-notion =
    .label = notion://
    .tooltiptext = Notion 页面
weavero-pref-links-scheme-obsidian =
    .label = obsidian://
    .tooltiptext = Obsidian 笔记
weavero-pref-links-scheme-slack =
    .label = slack://
    .tooltiptext = Slack 频道
weavero-pref-links-scheme-vscode =
    .label = vscode://
    .tooltiptext = VS Code 工作区 / 文件
weavero-pref-links-scheme-zoom =
    .label = zoommtg://
    .tooltiptext = Zoom 会议

weavero-pref-links-view-icons =
    .label = 在文档视图中的注释上显示图标
weavero-pref-links-view-icons-desc = 在页面上为带有链接或相关条目的注释绘制链接/相关条目徽标。取消勾选可使文档不显示任何叠加图标。
weavero-pref-links-apply-title = 应用于
weavero-pref-links-apply-library = 文库：
weavero-pref-links-apply-items-list =
    .label = 条目列表
weavero-pref-links-apply-annotations-panel =
    .label = 注释面板
weavero-pref-links-apply-reader = 阅读器：
weavero-pref-links-apply-reader-sidebar =
    .label = 侧边栏
weavero-pref-links-apply-document-view =
    .label = 文档视图
weavero-pref-links-apply-notes = 笔记：
weavero-pref-links-apply-note-editor =
    .label = 编辑器
    .tooltiptext = 笔记编辑器中的链接和 Markdown
weavero-pref-links-apply-notes-pane =
    .label = 笔记窗格
    .tooltiptext = 内容窗格笔记列表（所有笔记）中的链接
weavero-pref-links-apply-notes-list =
    .label = 条目列表
    .tooltiptext = 条目列表中笔记条目标题里的链接
weavero-pref-links-apply-desc = Weavero 渲染注释链接和 Markdown 的位置。
weavero-pref-links-internal-title = 内部链接导航
weavero-pref-links-internal-desc = <strong>Ctrl/Cmd+单击</strong>内部链接（图、公式、引用）会将其目标发送到拆分窗格；<strong>Shift+单击</strong>则发送到单独的窗口。尚未打开拆分视图时，新建：
weavero-pref-links-internal-horizontal =
    .label = 横向拆分
weavero-pref-links-internal-vertical =
    .label = 竖向拆分

weavero-pref-uri-title = URI 工具
weavero-pref-uri-enable =
    .aria-label = 启用 URI 工具
weavero-pref-uri-desc = 右键菜单项，可将 <span data-l10n-name="mono">zotero://</span> 深层链接复制到剪贴板。
weavero-pref-uri-copy-item =
    .label = 条目菜单中的“复制选择链接”/“复制打开链接”
weavero-pref-uri-copy-item-desc = 复制一个可前往该条目的 <span data-l10n-name="mono">zotero://select/…</span> 链接。
weavero-pref-uri-copy-collection =
    .label = “复制分类链接”/“复制已保存搜索链接”
weavero-pref-uri-copy-collection-desc = 在分类窗格的右键菜单中添加复制链接的菜单项。

weavero-pref-relations-title = 关联与链接条目
weavero-pref-relations-enable =
    .aria-label = 启用关联与链接条目功能
weavero-pref-relations-desc = 基于 Zotero 的相关条目关联及条目链接机制的功能。
weavero-pref-relations-add-related =
    .label = 条目列表菜单中的“添加关联…”
weavero-pref-relations-add-related-desc = 打开选择条目对话框，并将选中的条目互相设为相关条目（支持同时选中多个注释）。
weavero-pref-relations-chain-badge =
    .label = 在带有相关条目的注释行上显示链条徽标
weavero-pref-relations-chain-badge-desc = 在带有相关条目的注释旁显示一个链条图标；单击它可查看列表。
weavero-pref-relations-backlinks =
    .label = 条目窗格中的“反向链接”栏
weavero-pref-relations-backlinks-desc = 有哪些内容链接到这里：带有指向所选条目的 Zotero 链接（zotero://）或笔记引注的注释评论和笔记，按所属条目分组，并显示链接周围的文字。也出现在阅读器和笔记标签页的内容窗格中，以及“有反向链接”筛选条件中。
weavero-pref-relations-item-links =
    .label = 条目窗格中的“条目链接”栏
weavero-pref-relations-item-links-desc = 所选条目链接到哪里：写在其笔记和注释评论中的 Zotero 链接（zotero://）和笔记引注（Zotero 笔记编辑器添加到笔记中的引注和注释），按包含它们的笔记或注释分组，并显示每个链接周围的文字。若链接的条目已不存在，或其群组文库不在此配置文件中，该链接会以灰色列出且不计数。也出现在阅读器和笔记标签页的内容窗格中，以及指针停留在笔记、注释评论或条目列表中的 Zotero 链接或笔记引注上时显示的卡片中。
weavero-pref-relations-children-scope =
    .label = 在“标签”和“相关”栏中统计并列出子项的标签和相关条目
weavero-pref-relations-children-scope-desc = 在“标签”和“相关”栏标题旁，显示条目自身有多少，以及其附件、笔记和注释各有多少。单击某个计数可只显示这些，Alt+单击可隐藏它们；子项的标签或相关条目列在条目自身的之后，位于该子项的小标题下。关闭时，这两栏与 Zotero 原本的显示相同。
weavero-pref-relations-open-related =
    .label = 阅读器中的“打开相关条目”子菜单
weavero-pref-relations-open-related-desc = 在注释右键菜单中，为每个相关条目提供“在阅读器中打开”/“在新窗口中打开”菜单项。
weavero-pref-relations-libraries-tint =
    .label = 在条目窗格中为链接的文库行着色
weavero-pref-relations-libraries-tint-desc = 在“文库和分类”栏中突出显示当前条目所在文库的行。

weavero-pref-filters-title = 排序与筛选
weavero-pref-filters-enable =
    .aria-label = 启用排序与筛选
weavero-pref-filters-desc = 对可见内容进行排序、隐藏、淡化或限定范围的控件：阅读器中的注释排序、条目列表筛选窗格（工具栏的 ▾ 按钮），以及标签页菜单中按文库/文件类型的筛选。
weavero-pref-filters-ann-sort =
    .label = 阅读器中的注释排序
weavero-pref-filters-ann-sort-desc = 按位置、添加日期或修改日期对阅读器的注释侧边栏排序：右键单击“注释”选项卡标题可打开菜单；按日期排序时会出现一键排序栏，此时卡片会同时显示两个日期，排序所依据的日期在前。
weavero-pref-filters-card-date-added =
    .label = 在注释卡片上显示添加日期
weavero-pref-filters-card-date-modified =
    .label = 在注释卡片上显示修改日期
weavero-pref-filters-card-dates-desc = 无论如何排序，日期都显示在阅读器注释侧边栏中每张卡片的底部；悬停在日期上可查看两个完整日期。在阅读器中右键单击“注释”选项卡标题，可仅为该文档进行选择。从其他程序制作的 PDF 中导入的注释，其日期为 Zotero 导入它们的日期。
weavero-pref-filters-items-tree =
    .label = 条目列表筛选窗格
weavero-pref-filters-items-tree-desc = 搜索框旁的工具栏 ▾ 按钮，以及筛选弹窗（颜色/类型/文件类型、标签、作者、分类、已保存搜索）。
weavero-pref-filters-read-status =
    .label = 阅读状态筛选（Zotero Reading List）
weavero-pref-filters-read-status-desc = 安装 Zotero Reading List 插件后，在条目列表筛选弹窗中添加阅读状态切换行：按 ⭐ 新 / 📙 待读 / 📖 在读 / 📗 已读 / … 筛选（Alt+单击可排除）。
weavero-pref-filters-item-count =
    .label = 详细条目计数
weavero-pref-filters-item-count-desc = 将条目窗格中的“此视图中有 N 个条目”替换为细分计数（条目 · 附件 · 笔记 · 注释），以清楚说明这个数字统计的是什么，以及展开某一行时它为何变化。筛选生效时，还会显示有多少行是匹配项、多少行仅作为上下文显示。关闭则使用 Zotero 的单一数字。
weavero-pref-filters-selection-target =
    .label = 选择目标三态
weavero-pref-filters-selection-target-desc = 上级条目/附件/注释复选框，用于限定 Ctrl+A 的范围并淡化范围外的行。
weavero-pref-filters-collapse-advanced =
    .label = 将高级搜索折叠回快速搜索
weavero-pref-filters-collapse-advanced-desc = Zotero 的折叠按钮会隐藏高级搜索编辑器，但保留其筛选效果，只留下“高级搜索”字样。开启此项后，只要该搜索能用快速搜索表达（在“标题、创建者、年份”“所有字段和标签”或“所有内容”中的普通词语），折叠就会改为回到显示同一查询的快速搜索框，正好是用漏斗按钮展开它的逆操作。使用其他条件（如创建者或日期条件）的搜索仍按 Zotero 的方式折叠。关闭按钮 ✕ 总是清除并关闭搜索。
weavero-pref-filters-tabs-library =
    .label = 标签页菜单按文库筛选
weavero-pref-filters-tabs-library-desc = “列出所有标签页”弹窗中每个文库标题旁的复选框，用于隐藏这些标签页。
weavero-pref-filters-tabs-file-type =
    .label = 标签页菜单按文件类型筛选
weavero-pref-filters-tabs-file-type-desc = “列出所有标签页”弹窗中的漏斗按钮，用于按附件类型筛选。

weavero-pref-bookmarks-title = 书签
weavero-pref-bookmarks-enable =
    .aria-label = 启用书签
weavero-pref-bookmarks-desc = 两种范围的书签：分类窗格工具栏上的下拉菜单，用于条目/分类/搜索；阅读器侧边栏中的选项卡，用于文档内的位置。
weavero-pref-bookmarks-sync-note = 书签暂时不会在计算机之间同步——它们存储在本地的 <span data-l10n-name="mono">&lt;Zotero data dir&gt;/weavero/bookmarks.json</span> 中。（Zotero 推出由插件管理的同步存储后，将改用该存储。）
weavero-pref-bookmarks-library =
    .label = 文库书签
weavero-pref-bookmarks-library-desc = 分类窗格工具栏上的“书签”下拉菜单，用于条目/分类/已保存搜索。
weavero-pref-bookmarks-library-autohide =
    .label = 文库书签为空时自动隐藏其按钮
weavero-pref-bookmarks-collection-scroll-title = 书签中的分类显示在何处
weavero-pref-bookmarks-collection-scroll-desc = 当书签打开分类、文库或已保存搜索时，分类窗格会将其滚动到：
weavero-pref-bookmarks-collection-scroll-top =
    .label = 窗格顶部（默认）
weavero-pref-bookmarks-collection-scroll-native =
    .label = Zotero 自身的行为：仅滚动到需要的位置
weavero-pref-bookmarks-document =
    .label = 文档书签
weavero-pref-bookmarks-document-desc = 阅读器侧边栏中的“书签”选项卡，用于文档内的位置。将注释或选中内容拖放到它上面即可添加书签。
weavero-pref-bookmarks-document-autohide =
    .label = 文档书签为空时自动隐藏其选项卡
weavero-pref-bookmarks-library-in-reader =
    .label = 在阅读器中显示文库书签选项卡
weavero-pref-bookmarks-library-in-reader-desc = 在浏览文档内书签的同时浏览文库书签（Ctrl+单击可合并两个视图）。
weavero-pref-bookmarks-page-numbers =
    .label = 在文档书签旁显示页码
weavero-pref-bookmarks-page-numbers-desc = 每个书签右侧的“第 N 页”字样。在阅读器中右键单击“书签”选项卡，可仅为该文档显示或隐藏页码。悬停卡片仍会显示页码。

weavero-pref-tabs-title = 标签页与窗口
weavero-pref-tabs-enable =
    .aria-label = 启用标签页与窗口功能
weavero-pref-tabs-desc = 标签页组、浏览器风格的窗口外观、多个主窗口，以及单独阅读器窗口中的条目窗格。
weavero-pref-tabs-desc-native = 标签页组、浏览器风格的窗口外观，以及在多个窗口中工作的工具。
weavero-pref-tabs-groups =
    .label = 标签栏中的标签页组
weavero-pref-tabs-groups-desc = 以 Firefox 的方式为标签页分组：右键单击标签页 →“添加到标签页组…”，即可创建带名称和颜色的组。单击组标头可折叠或展开该组；右键单击组标头可重命名、更改颜色、取消分组或关闭该组。组在重启后仍会保留。
weavero-pref-tabs-split-view =
    .label = 拆分视图
weavero-pref-tabs-split-view-desc = 以 Firefox 的方式并排显示两个标签页：右键单击标签页 →“添加拆分视图”，或选择两个标签页后选择“在拆分视图中打开”。在条目列表中，“在拆分视图中打开 PDF”会将其打开在文库旁边；笔记和评论中的链接提供“在拆分视图中打开链接”。拖动两者之间的分隔条可调整大小。拆分视图在重启后仍会保留。
weavero-pref-tabs-split-dock-desc = 要让某个标签页始终可见，右键单击它 →“锁定标签页”：它会移到窗口左侧，右侧显示您选择的任意标签页（锁定文库后，从中打开的条目会在它旁边打开）。锁定的标签页带有金色边框，图标上有一把锁；当您位于该标签页时，旁边显示的标签页会变暗。单击锁定的标签页可折叠其所在一侧，让窗口只显示您当前所在的标签页；再次单击可恢复。要解锁，右键单击它 →“解锁标签页”。
weavero-pref-tabs-split-footer =
    .label = 在条目窗格已关闭的一侧显示标题条
weavero-pref-tabs-split-footer-desc = 在拆分视图中，条目窗格已关闭的一侧会在底角显示其标签页的图标和标题，并带有拆分视图菜单（分离标签页、调换标签页、关闭两个标签页）。打开该侧的条目窗格会隐藏标题条：窗格的题头已写明条目。
weavero-pref-tabs-library-pin-name =
    .label = 固定文库标签页时显示其名称
weavero-pref-tabs-library-pin-name-desc = 固定的“我的文库”（或群组文库）标签页显示其图标和名称，宽度随名称而定，而不是只显示图标。此选项是每个文库标签页的默认设置；固定标签页右键菜单中的“显示标签页名称”只显示或隐藏该标签页的名称，标签页自己的选择优先于此选项。
weavero-pref-tabs-sessions =
    .label = 标签页会话
weavero-pref-tabs-sessions-desc = 在“列出所有标签页”弹窗中保存并切换已命名的标签页集合。您当前的标签页始终属于当前会话；“+ 新建会话”会打开一个全新的工作区，切换只需单击一次。关闭此项会隐藏会话界面并冻结已保存的会话——它们保持休眠（绝不会被覆盖），重新启用后会再次出现。
weavero-pref-tabs-window-icons =
    .label = 每个窗口独立的任务栏图标（Windows）
weavero-pref-tabs-window-icons-desc = 为每个额外窗口提供自己的图标：主窗口为带彩色方形徽标的 Zotero 图标，阅读器窗口为带彩色圆形徽标的 Zotero 图标（首要窗口保留原图标）。这样任务栏预览、任务视图和 Alt+Tab 能一眼区分各个窗口，就像 Chrome 为其个人资料窗口加徽标一样。仅限 Windows。
weavero-pref-tabs-window-icons-desc-native = 为每个额外窗口提供自己的图标：带彩色方形徽标的 Zotero 图标（首要窗口保留原图标）。这样任务栏预览、任务视图和 Alt+Tab 能一眼区分各个窗口，就像 Chrome 为其个人资料窗口加徽标一样。仅限 Windows。
weavero-pref-tabs-windows-only = 仅限 Windows——在此系统上无效。
weavero-pref-tabs-taskbar-buttons =
    .label = 每个窗口单独的任务栏按钮（Windows）
weavero-pref-tabs-taskbar-buttons-desc = 为每个额外窗口（主窗口和阅读器窗口）提供自己的任务栏按钮及其徽标图标，显示在窗口所在的显示器上，而不是将所有窗口归到一个 Zotero 按钮下。注意：分开的窗口不再出现在共享的预览浮出框中。默认关闭。
weavero-pref-tabs-taskbar-buttons-desc-native = 为每个额外窗口提供自己的任务栏按钮及其徽标图标，显示在窗口所在的显示器上，而不是将所有窗口归到一个 Zotero 按钮下。注意：分开的窗口不再出现在共享的预览浮出框中。默认关闭。
weavero-pref-tabs-progress-window =
    .label = “查找全文”窗口的最小化和最大化按钮
weavero-pref-tabs-progress-window-desc = “查找全文”和“检索元数据”的进度窗口在标题栏上显示最小化和最大化按钮，其“最小化”按钮会将窗口最小化，而不是关闭它。两种情况下工作都会继续。默认开启。
weavero-pref-tabs-title-glyphs =
    .label = 在窗口标题中显示窗口类型符号
weavero-pref-tabs-title-glyphs-desc = 适用于非 Windows 平台的替代方案（默认关闭）：在每个窗口标题前加上一个小类型标记——首要窗口为 ⚓，其他主窗口为方块（■ □ ▣），阅读器窗口为圆圈（● ○ ◉）。在标题刷新时生效，例如下次切换标签页时。
weavero-pref-tabs-title-glyphs-desc-native = 适用于非 Windows 平台的替代方案（默认关闭）：在每个窗口标题前加上一个小类型标记——首要窗口为 ⚓，其他窗口为方块（■ □ ▣）。在标题刷新时生效，例如下次切换标签页时。
weavero-pref-tabs-window-name-title = 窗口标题中的窗口名称
weavero-pref-tabs-window-name-desc = 在操作系统标题（任务栏预览、Alt+Tab 和任务视图）中显示重命名窗口的名称，类似 Chrome 的“为窗口命名”。<strong>在标题前</strong>保留页面上下文（“主窗口 — Azam et al.”）；<strong>替换标题</strong>只显示名称。没有自定义名称的窗口始终保持正常标题。
weavero-pref-tabs-window-name-off =
    .label = 关闭
weavero-pref-tabs-window-name-prefix =
    .label = 在标题前
weavero-pref-tabs-window-name-replace =
    .label = 替换标题

weavero-pref-titlebar-title = 隐藏标题栏
weavero-pref-titlebar-enable =
    .aria-label = 隐藏标题栏（Firefox 风格）
weavero-pref-titlebar-desc = 用浏览器风格的栏替换标题栏：菜单会让出位置（按 Alt 显示），窗口按钮移入标签栏。仅限 Windows / Linux。
weavero-pref-titlebar-apply = 应用于：
weavero-pref-titlebar-main =
    .label = 主窗口
weavero-pref-titlebar-reader =
    .label = 阅读器窗口
weavero-pref-titlebar-note =
    .label = 笔记窗口
weavero-pref-titlebar-plugins-manager =
    .label = 插件管理器
weavero-pref-titlebar-note-deck =
    .label = 在可容纳标签页的窗口中打开笔记
weavero-pref-titlebar-note-deck-desc = 在新窗口中打开笔记时，使用阅读器式窗口，可接受拖入的 PDF/笔记标签页。需要在上方替换阅读器窗口的标题栏。独立笔记（无上级条目）在窗口打开时会短暂显示一个占位文档。

weavero-pref-mainwin-title = 多个主窗口
weavero-pref-mainwin-native-note = 此版本的 Zotero 自带窗口和文库标签页，因此由它自行打开、移动和恢复这些窗口，属于 Weavero 自身额外窗口的选项在此处关闭。已保存的窗口、标签页会话和高级搜索窗口照常工作。
weavero-pref-mainwin-enable =
    .label = 打开新的主窗口
weavero-pref-mainwin-enable-desc = 一个独立的第二主窗口，拥有自己的标签页、列、筛选和窗格宽度：Ctrl+N / ⌘N、<em>文件 → 新建主窗口</em>、标签页和条目菜单中的<em>新窗口</em>菜单项，以及在新窗口中打开高级搜索。关闭时，以上操作都不会打开新窗口。
weavero-pref-mainwin-restore =
    .label = 重启时恢复额外窗口
weavero-pref-mainwin-restore-desc = Zotero 重启时重新打开您之前打开的额外窗口。
weavero-pref-mainwin-adv-shortcut =
    .label = Ctrl+Shift+F / ⇧⌘F 在新窗口中打开高级搜索
weavero-pref-mainwin-adv-shortcut-desc = Zotero 的高级搜索快捷键会在当前窗口中打开搜索。开启此项后，它会改为针对当前分类打开一个新窗口，与 Shift+单击漏斗按钮或<em>编辑 → 在新窗口中打开高级搜索</em>相同。Zotero 10。
weavero-pref-mainwin-adv-hide-panes =
    .label = 在高级搜索窗口中隐藏侧边窗格
weavero-pref-mainwin-adv-hide-panes-desc = 窗口打开时只显示搜索及其结果，没有分类窗格，也没有条目窗格，就像 Zotero 9 的独立高级搜索窗口。在该窗口中通过<em>查看 → 布局</em>可恢复窗格。

weavero-pref-reader-pane-title = 单独阅读器窗口中的条目窗格
weavero-pref-reader-pane-enable =
    .label = 在单独窗口中的阅读器旁显示条目窗格
weavero-pref-reader-pane-desc = 为独立阅读器窗口添加条目信息/内容窗格（各栏、侧边导航），就像主窗口的右侧窗格。

weavero-pref-extras-title = 附加功能
weavero-pref-extras-enable =
    .aria-label = 启用视觉附加功能
weavero-pref-extras-desc = 附加在现有 Zotero 界面上的小型信息显示：条目列表徽标、条目列表的额外列和标签栏符号。

weavero-pref-columns-title = 条目列表的列
weavero-pref-columns-desc = 额外的列，在您从列选择器中启用之前一直隐藏（右键单击条目列表的表头）。
weavero-pref-columns-annotations =
    .label = “注释”列
weavero-pref-columns-annotations-desc = 附件上的注释数量（对普通条目则为其所有附件之和）。
weavero-pref-columns-tags-auto =
    .label = “标签”列——加上自动标签数量
weavero-pref-columns-tags-auto-desc = 显示手动标签（蓝色）和自动标签。取消勾选则只显示手动标签数量。这是每个窗口的默认设置：每个窗口都可以从列标题的右键菜单（标签 › 自动标签计数）中自行选择。
weavero-pref-columns-related =
    .label = “相关”列
weavero-pref-columns-related-desc = 每行的相关条目数量。
weavero-pref-columns-backlinks =
    .label = “反向链接”列
weavero-pref-columns-backlinks-desc = 其他地方链接到该条目及其附件、笔记或注释的注释评论和笔记的数量。
weavero-pref-columns-item-links =
    .label = “条目链接”列
weavero-pref-columns-item-links-desc = 该行的笔记和注释评论通过 Zotero 链接或笔记引注所链接到的 Zotero 条目数量（失效的链接会列出，但不计数）。
weavero-pref-columns-ext-links =
    .label = “外部链接”列
weavero-pref-columns-ext-links-desc = 该行的笔记和注释评论中写有的网页链接和应用链接数量（每个链接只计一次；zotero:// 链接属于“条目链接”）。单击数字可查看列表。

weavero-pref-itemslist-title = 条目列表与标签页
weavero-pref-itemslist-title-lines = 条目列表中的标题
weavero-pref-itemslist-title-lines-off =
    .label = 单行
weavero-pref-itemslist-title-lines-fixed =
    .label = 固定高度
weavero-pref-itemslist-title-lines-adaptive =
    .label = 适应每个标题
weavero-pref-itemslist-title-lines-lead = { $mode ->
        [fixed] 高度为
       *[other] 最多
    }
weavero-pref-itemslist-title-lines-unit = 行
weavero-pref-itemslist-title-lines-desc = “固定高度”使每一行都与这么多行文本一样高。“适应每个标题”使每一行的高度刚好容纳其标题，最多不超过这么多行。其他文本列在该高度内换行，所有内容都位于行的顶部。更长的文本以省略号结尾，子行保持单行。
weavero-pref-itemslist-added-by =
    .label = 为注释显示“添加人”
weavero-pref-itemslist-added-by-desc = 在群组文库中，在注释行旁显示带有注释创建者的徽标。
weavero-pref-itemslist-added-by-colors =
    .label = 在“添加人”中为每位用户使用不同颜色
weavero-pref-itemslist-added-by-colors-desc = 用每位用户各自的颜色为“添加人”文字和徽标着色。取消勾选则使用默认文字颜色。
weavero-pref-itemslist-group-glyph =
    .label = 标签页上的群组文库符号和提示
weavero-pref-itemslist-group-glyph-desc = 对于条目位于群组文库中的标签页，在其文件类型图标上显示一个群组符号，并提供更丰富的提示。
weavero-pref-itemslist-tab-ring =
    .label = Firefox 风格的标签页：圆角，选中的标签页带轮廓
weavero-pref-itemslist-tab-ring-desc = 胶囊形状的标签页，选中的标签页周围有一圈从紫罗兰色渐变到橙色的细轮廓，就像 Firefox 新的标签页设计。取消勾选则使用 Zotero 自己的标签页：方角，选中的标签页凸起。
weavero-pref-itemslist-layout-menu =
    .label = “查看 → 布局”随标签页而变
weavero-pref-itemslist-layout-menu-desc = 无论前台是哪个标签页，Zotero 的<em>查看 → 布局</em>菜单项都切换文库的窗格。在阅读器标签页中，该子菜单改为显示阅读器自己的窗格：<em>侧边栏</em>、<em>内容窗格</em>以及注释窗格底部的<em>颜色和标签选择器</em>，并以勾选标记显示其实际状态；笔记标签页显示<em>内容窗格</em>（安装 Better Notes 时还有<em>大纲窗格</em>）；文库标签页保留 Zotero 的菜单项。单独的阅读器窗口有自己的“布局”子菜单。关闭时，菜单保持 Zotero 原样。
weavero-pref-itemslist-layout-menu-desc-native = 无论前台是哪个标签页，Zotero 的<em>查看 → 布局</em>菜单项都切换文库的窗格。在阅读器标签页中，该子菜单改为显示阅读器自己的窗格：<em>侧边栏</em>、<em>内容窗格</em>以及注释窗格底部的<em>颜色和标签选择器</em>，并以勾选标记显示其实际状态；笔记标签页显示<em>内容窗格</em>（安装 Better Notes 时还有<em>大纲窗格</em>）；文库标签页保留 Zotero 的菜单项。关闭时，菜单保持 Zotero 原样。

weavero-pref-collections-title = 分类窗格
weavero-pref-collections-pane-toggle =
    .label = 分类窗格的折叠/展开按钮
weavero-pref-collections-pane-toggle-desc = 工具栏左端的一个按钮，与条目窗格和阅读器的按钮类似。<em>查看 → 布局</em>仍可同时使用。
weavero-pref-collections-tag-selector-handle =
    .label = 标签选择器上的把手：单击可折叠或展开
weavero-pref-collections-tag-selector-handle-desc = 标签选择器上边缘的一个小胶囊。单击一次将选择器折叠到该边缘，再单击一次恢复；拖动边缘仍可调整其大小。选择器折叠时，已选中的标签会继续筛选列表，胶囊会变成蓝色以示提醒。<em>查看 → 布局 → 标签选择器</em>显示相同的状态。
weavero-pref-collections-no-collapse =
    .label = 调整侧边窗格大小时止于其最小宽度
weavero-pref-collections-no-collapse-desc = 拖动侧边窗格的边缘时，会停在其最窄宽度，而不是一下子将其关闭：分类窗格、条目窗格、阅读器标签页的内容窗格以及阅读器窗口的条目窗格。请用它们的按钮或<em>查看 → 布局</em>来折叠它们。关闭时，它们都会像在 Zotero 中那样一下子关闭。
weavero-pref-collections-no-collapse-desc-native = 拖动侧边窗格的边缘时，会停在其最窄宽度，而不是一下子将其关闭：分类窗格、条目窗格以及阅读器标签页的内容窗格。请用它们的按钮或<em>查看 → 布局</em>来折叠它们。关闭时，它们都会像在 Zotero 中那样一下子关闭。
weavero-pref-collections-sticky-parents =
    .label = 滚动时将上级分类固定在顶部
weavero-pref-collections-sticky-lead = 最多
weavero-pref-collections-sticky-unit = 层
weavero-pref-collections-sticky-parents-desc = 窗格顶部分类的上级分类会固定在它们上方，就像 VS Code 的文件树。单击固定的上级分类可前往该分类；其箭头可将其折叠。分类与文库管理器的两个树也以同样的方式固定。
weavero-pref-collections-search-folders =
    .label = 已保存搜索的文件夹
weavero-pref-collections-search-folders-names =
    .label = 也从搜索名称中读取文件夹（人员/学生/…）
weavero-pref-collections-search-folders-desc = 已保存的搜索可以在其文库下归入文件夹：将搜索拖到文件夹上，或右键单击它：移至文件夹。Weavero 在本机保存这些文件夹；您的文库不会有任何改变。每个会话会保存哪些文件夹处于展开状态。启用第二个选项后，名为“A/B/C”的搜索会显示为文件夹 A › B 中的“C”，与 Saved Search Folders 插件相同。
weavero-sf-move-to =
    .label = 移至文件夹
weavero-sf-unfiled =
    .label = 不在文件夹中
weavero-sf-new-folder =
    .label = 新建文件夹…
weavero-sf-new-subfolder =
    .label = 新建子文件夹…
weavero-sf-new-search-folder =
    .label = 新建搜索文件夹…
weavero-sf-rename-folder =
    .label = 重命名文件夹…
weavero-sf-move-folder =
    .label = 将文件夹移至
weavero-sf-top-level =
    .label = 顶层
weavero-sf-delete-folder =
    .label = 删除文件夹
weavero-sf-folder-name-title = 已保存搜索的文件夹
weavero-sf-folder-name-prompt = 文件夹名称：
weavero-sf-delete-confirm = 删除文件夹“{ $name }”及其 { $count } 个子文件夹？其中的已保存搜索仍保留在您的文库中，不属于任何文件夹。
weavero-sf-name-folder = 来自搜索名称：{ $path }
weavero-pref-collections-bookmarks-pane =
    .label = 在分类上方显示书签窗格
weavero-pref-collections-bookmarks-pane-desc = 在分类树上方的窗格中显示文库书签，两者之间有分隔条。点击其标题可折叠；其 ⇕ 按钮只显示书签，取代分类树。文件夹就地展开；拖放到某个分类书签上的条目会加入该分类。每个窗口保留自己的布局，并随其会话保存。分类上方的“书签”按钮依然保留。
weavero-bmpane-fold-tip = { $folded ->
        [yes] 展开书签
       *[other] 折叠书签
    }
weavero-bmpane-only-tip = { $on ->
        [yes] 重新显示分类树
       *[other] 仅显示书签：隐藏分类树
    }
weavero-bmpane-now-tip = 正在显示：{ $name }。点击可显示分类树并定位到它。
weavero-bmpane-now-add = 添加书签
weavero-bmpane-folder-current = 此文件夹包含当前显示的内容
# The funnel above the collections pane (coll-funnel.ts): Settings.
weavero-pref-collections-funnel =
    .label = 分类窗格上方的漏斗
weavero-pref-collections-funnel-desc = 分类窗格工具栏中的漏斗按钮可筛选窗格显示的内容：分类、已保存的搜索、订阅、特殊行（重复条目、未分类条目、回收站…）、每个文库以及 Weavero 自己的区域。单击一个标签只显示它，Alt+单击隐藏它。每个窗口保留自己的筛选，随其会话保存；漏斗中的“设为默认”使其成为每个窗口开始时的筛选。
weavero-pref-collfunnel-defaults-title = 默认显示
weavero-pref-collfunnel-show-collections =
    .label = 分类
weavero-pref-collfunnel-show-searches =
    .label = 已保存的搜索
weavero-pref-collfunnel-show-feeds =
    .label = 订阅
weavero-pref-collfunnel-show-special =
    .label = 特殊行
weavero-pref-collfunnel-show-bookmarks =
    .label = 书签窗格
weavero-pref-collfunnel-show-folders =
    .label = 已保存搜索的文件夹
# The libraries the default leaves out. $mode: hidden, only or none; $names: the libraries.
weavero-pref-collfunnel-libs = { $mode ->
        [hidden] 默认隐藏的文库：{ $names }
        [only] 默认显示的文库：仅 { $names }
       *[none] 默认显示所有文库。
    }
weavero-pref-collfunnel-libs-reset = 重置
# The funnel's button. $active: yes when it filters; $parts: what it filters.
weavero-cf-tb-tip = { $active ->
        [yes] 分类窗格筛选：{ $parts }
       *[no] 筛选分类窗格
    }
# The funnel's rows of chips.
weavero-cf-row-kinds = 类型
weavero-cf-row-libs = 文库
weavero-cf-row-secs = Weavero 区域
weavero-cf-kind-collections = 分类
weavero-cf-kind-searches = 已保存的搜索
weavero-cf-kind-feeds = 订阅
weavero-cf-kind-special = 特殊行
weavero-cf-kind-special-tip = 重复条目、未分类条目、最近阅读、已撤稿条目、我的出版物和回收站
weavero-cf-sec-bookmarks = 书签窗格
weavero-cf-sec-folders = 已保存搜索的文件夹
weavero-cf-hint = 单击：只显示此项。Alt+单击：隐藏。
# What a row filters, in the button's tooltip. $mode: only or hide; $names: the chips.
weavero-cf-part = { $mode ->
        [only] 仅 { $names }
       *[hide] 隐藏 { $names }
    }
# The footer's line. $scope: window (this window's own filter) or default.
weavero-cf-scope = { $scope ->
        [window] 此窗口自己的筛选
       *[default] 遵循默认筛选
    }
    .title = { $scope ->
        [window] 此窗口偏离默认筛选；“恢复默认”会重新遵循它。
       *[default] 此窗口显示默认筛选，可用“设为默认”更改。
    }
weavero-cf-use-default = 设为默认
    .title = 将此筛选按当前状态设为每个窗口开始时的筛选
weavero-cf-reset-default = 恢复默认
    .title = 在此窗口中恢复默认筛选
# Where the funnel leaves nothing in the tree.
weavero-cf-empty = 没有与漏斗匹配的内容。
weavero-cf-empty-clear = 清空
weavero-pref-collections-sticky-headers =
    .label = 滚动时将栏标题固定在条目窗格顶部
weavero-pref-collections-sticky-headers-desc = 每个栏的标题在其内容滚动经过时固定在条目窗格顶部，并被下一个标题推出；在“条目链接”“反向链接”以及加宽的“标签”和“相关”栏内，正在经过的部分的小标题会固定在栏标题下方。单击固定的标题仍可折叠其所在栏。适用于文库的条目窗格，以及阅读器和笔记标签页的内容窗格。
weavero-pref-collections-path-tooltip =
    .label = 悬停在分类上时显示其完整路径
weavero-pref-collections-indent-guides =
    .label = 分类窗格中的缩进参考线
weavero-pref-collections-indent-guides-desc = 每一层显示一条淡淡的竖线，使同级分类在视觉上对齐。

weavero-pref-plugins-title = 插件管理器
weavero-pref-plugins-extras =
    .label = 插件管理器增强（搜索框、卡片详情、普通窗口）
weavero-pref-plugins-extras-desc = “工具 → 插件”会获得一个搜索框（Ctrl+F 聚焦，× 清空）、显示作者 [GitHub 所有者] · 版本 · 最后更新时间的卡片、一个可最小化/最大化的普通窗口（开启<em>隐藏标题栏 → 插件管理器</em>时使用主窗口的标题栏布局；关闭时使用系统自己的标题栏和菜单栏），以及始终可见的“最近更新”，其标题上有一个菜单，可选择回溯多久（从最近一天到全部；Zotero 自己的只到 2 天），并会被记住。管理器重新打开时显示插件列表。在 Zotero 11 上，管理器隐藏了侧边栏，此时侧边栏会恢复，并显示“插件”和“最近更新”（有待安装的更新时还会显示“可用更新”）。

weavero-pref-defatt-title = 默认附件
weavero-pref-defatt-enable =
    .label = 打开所选的附件或笔记，而不是 Zotero 自动选择的
weavero-pref-defatt-desc = 右键单击条目的任意子项——附件（PDF 或其他格式）、链接的网址或笔记——选择<b>▶️ 设为默认附件</b>，即可打开该子项而不是 Zotero 通常的选择。所做的选择以标签 <b>▶️ wv-defatt</b> 的形式存储在该子项上，因此会同步到您的其他设备，即使没有 Weavero 也会保留。搜索 <b>wv-defatt</b>（或 ▶️ 符号）可列出所有已标记的条目；该标签特意不含普通词语，因此绝不会出现在无关的搜索中。关闭此项会停止覆盖，但保留您的选择。
weavero-pref-defatt-sort-default =
    .label = 在附件列表中将默认附件显示在最前
weavero-pref-defatt-sort-auto =
    .label = 未设置默认附件时，将 Zotero 的自动选择显示在最前
weavero-pref-defatt-mark-auto =
    .label = 在条目列表中用暗色 ▷ 标记自动选择
weavero-pref-defatt-sort-desc = 启用上面两个选项后，双击时打开的附件总是位于条目附件的第一行。暗色的 <b>▷</b> 始终表示 Zotero 自己的自动选择（这样您可以看到移除所选默认附件后会打开什么），而所选的默认附件保留实心的 <b>▶️</b> 标记。
weavero-pref-defatt-import = 之前使用 <b>PikaPei</b> 的 <b>Default Attachment</b> 插件？Weavero 首次启动时会自动导入您的选择，并且不会改动该插件自己的数据——用完后如何手动移除它，请参阅 README。

weavero-pref-ext-viewer-title = 外部查看器
weavero-pref-ext-viewer-enable =
    .label = 条目/标签页菜单中的“在外部查看器中打开”
weavero-pref-ext-viewer-desc = 用操作系统的默认应用打开条目的最佳附件（PDF、EPUB、网页快照、图片…）。默认开启。

weavero-pref-undo-title = 撤销
weavero-pref-undo-buttons =
    .label = 阅读器工具栏中的撤销/重做箭头
weavero-pref-undo-buttons-desc = 位于注释工具之后的两个箭头：单击可撤销或重做阅读器标签页的最近一步（大纲、书签、注释），右键单击可查看历史记录。Ctrl+Z、Ctrl+Y 和“编辑 → 撤销”同样有效。默认开启。

weavero-pref-link-preview-title = 链接预览
weavero-pref-link-preview-entry =
    .label = 在链接预览中标出整条参考文献
weavero-pref-link-preview-entry-desc = 指针停留在引用上时，参考文献列表的预览会用浅红色标出所引文献的每一行，取代 Zotero 在其第一行上的深色框。关闭：保持 Zotero 原样的预览。默认开启。

weavero-pref-outline-title = 阅读器大纲
weavero-pref-outline-highlight =
    .label = 单击大纲项时高亮标题文字
weavero-pref-outline-highlight-desc = 单击时闪烁显示实际的标题文字，适用于 PDF、EPUB 和网页快照，也适用于从大纲跳转的笔记；对于内嵌的 PDF 大纲，Weavero 会在页面上查找该标题。尽力匹配：扫描页面或特殊字体可能只会跳转而不高亮。
weavero-pref-outline-page-numbers =
    .label = 在大纲项旁显示页码
weavero-pref-outline-page-numbers-desc = 每个大纲项右侧的“第 N 页”字样。在阅读器中右键单击“大纲”选项卡，可仅为该文档显示或隐藏页码。
weavero-pref-outline-size-title = 大纲文字大小
weavero-pref-outline-size-desc = <strong>Zotero 大纲</strong>和<strong>Zotero 条目窗格</strong>跟随<em>查看 → 字体大小</em>（显示的是当前大小）；<strong>固定</strong>则无论字体大小如何都保持所选大小。在阅读器中右键单击“大纲”选项卡，可仅为该文档选择大小。
weavero-pref-outline-size-zotero =
    .label = Zotero 大纲（默认）
weavero-pref-outline-size-item-pane =
    .label = Zotero 条目窗格
weavero-pref-outline-size-zotero-px =
    .label = Zotero 大纲，{ $px } px（默认）
weavero-pref-outline-size-item-pane-px =
    .label = Zotero 条目窗格，{ $px } px
weavero-pref-outline-size-fixed =
    .label = 固定：
weavero-pref-outline-size-px =
    .label = { $px } px

weavero-pref-outline-keys-title = 添加大纲项的键盘快捷键
weavero-pref-outline-keys-desc = 默认未设置任何快捷键。单击一个框并按下想要的按键（单个字母也可以）；Zotero 或阅读器已使用的组合键会被拒绝。快捷键在阅读器标签页中有效，在文本框中输入时无效，并会显示在相应菜单项旁。
weavero-pref-outline-key-selection = 添加所选文本
weavero-pref-outline-key-remove = 移除
weavero-pref-outline-key-pin = 钉住一个位置
weavero-pref-outline-key-page-top = 页面顶部（PDF）
weavero-pref-outline-key-page-bottom = 页面底部（PDF）

weavero-pref-notes-title = 笔记
weavero-pref-notes-outline =
    .label = 笔记旁的大纲
weavero-pref-notes-outline-desc = 笔记左侧的一个面板，列出笔记的各级标题，并标出您正在阅读的部分。单击标题可跳转到该处；右键单击可复制指向它的链接。在笔记标签页和窗口中默认打开，在条目窗格和阅读器旁默认收起——笔记工具栏左端的侧边栏按钮可显示或隐藏它。安装 Better Notes 时，此大纲会取代其在笔记标签页中的左侧窗格；取消勾选可恢复该窗格及其思维导图和气泡图。
weavero-pref-notes-folding =
    .label = 笔记标题和列表上的折叠箭头
weavero-pref-notes-folding-desc = 每个标题前页边空白处的箭头会隐藏其下的所有内容，直到下一个同级或更高级的标题。列表项（无序或有序）前的箭头会隐藏其第一行之下的所有内容：子项和后续段落。笔记右键菜单末尾的<em>全部折叠</em>和<em>全部展开</em>可一次处理整篇笔记。只有视图会改变——笔记本身不受影响，没有 Weavero 的人看到的是完整的笔记。折叠状态按笔记保存在此计算机上。这两个选项都需要开启<em>链接与关联 → 笔记：编辑器</em>。

weavero-pref-annpane-title = 阅读器注释窗格
weavero-pref-annpane-reader-funnel =
    .label = 阅读器上方的漏斗
weavero-pref-annpane-reader-funnel-desc = 同时在页面和注释窗格中筛选文档的注释（按颜色、类型、标签、评论、人员或日期）。关闭时按钮消失，其筛选被搁置：所有注释重新显示，但 Zotero 自带的颜色和标签选择器所筛选的除外。重新打开后，已打开的文档会恢复其筛选。
weavero-pref-annpane-funnel =
    .label = 窗格搜索框旁的漏斗
weavero-pref-annpane-funnel-desc = 与阅读器上方的漏斗不同（后者也会将注释从页面上隐藏），这个漏斗只筛选注释窗格（按颜色、类型、标签、评论、人员或日期），页面上仍保留所有注释。条件块和手势相同。每个文档保留自己的筛选；下面的类型是所有文档的起点。关闭漏斗时，窗格只遵循下面的类型。
weavero-pref-annpane-selector-handle =
    .label = 窗格底部 Zotero 颜色和标签选择器上的把手
weavero-pref-annpane-selector-handle-desc = 选择器上边缘的一个小胶囊：单击一次将选择器折叠到该边缘，再单击一次恢复。所有文档共用一个状态，重启后保留（初始为显示）。<em>查看 → 布局 → 颜色和标签选择器</em>会完全隐藏选择器（包括胶囊），就像文库的“标签选择器”菜单项那样。打开时，选择器会同时筛选窗格和文档；将注释拖放到某个颜色或标签上即可为其应用该颜色或标签（按住 Shift 则移除）。折叠时选择仍然有效；胶囊会变成蓝色以示提醒。关闭时，选择器始终显示，与 Zotero 中相同。
weavero-pref-annpane-types-title = 窗格中显示的注释类型
weavero-pref-annpane-types-desc = 取消勾选某个类型，即可在所有文档的窗格中略去该类型；它在页面上仍然可见。漏斗可以为单个文档覆盖此设置，其“设为默认”会写回这里。
weavero-pref-annpane-type-highlight =
    .label = 高亮
weavero-pref-annpane-type-underline =
    .label = 下划线
weavero-pref-annpane-type-note =
    .label = 笔记
weavero-pref-annpane-type-image =
    .label = 图片
weavero-pref-annpane-type-ink =
    .label = 笔迹
weavero-pref-annpane-type-text =
    .label = 文本

weavero-pref-debug-title = 调试
weavero-pref-debug-enable =
    .label = 启用调试日志
weavero-pref-debug-desc = 通过 Zotero.debug 输出详细的活动信息（帮助 → 调试日志 → 查看输出日志）。正常使用时请保持关闭。

weavero-pref-about-title = 关于
weavero-pref-about-homepage = 主页 — GitHub
weavero-pref-about-bug-report = 错误报告/功能请求

